<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Material 3 DayNight theme for BlueLight-PMMP.
         Picks light palette (values/colors.xml) or dark palette (values-night/colors.xml)
         depending on the night mode chosen in AppSettings. -->
    <style name="Theme.BlueLight" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash / launcher theme alias -->
    <style name="Theme.BlueLight.Launcher" parent="Theme.BlueLight">
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <!-- ============================================================= -->
    <!-- Gray theme (default): light-based with a gray neutral palette -->
    <!-- ============================================================= -->
    <!-- Deep gray: much darker neutral palette than the previous light gray -->
    <style name="Theme.BlueLight.Gray" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#8C99A3</item>
        <item name="colorOnPrimary">#14181B</item>
        <item name="colorPrimaryContainer">#33393F</item>
        <item name="colorOnPrimaryContainer">#D7DEE4</item>
        <item name="colorSecondary">#8C99A3</item>
        <item name="colorOnSecondary">#14181B</item>
        <item name="colorSecondaryContainer">#2F353A</item>
        <item name="colorOnSecondaryContainer">#D7DEE4</item>
        <item name="colorTertiary">#93A0AA</item>
        <item name="colorOnTertiary">#171B1F</item>
        <item name="colorTertiaryContainer">#363C42</item>
        <item name="colorOnTertiaryContainer">#DAE1E7</item>
        <item name="android:colorBackground">#1C1F22</item>
        <item name="colorSurface">#23272B</item>
        <item name="colorOnSurface">#E1E4E8</item>
        <item name="colorSurfaceVariant">#33383E</item>
        <item name="colorOnSurfaceVariant">#C2C8CE</item>
        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>
        <item name="colorOutline">#8C959C</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- ============================================================= -->
    <!-- Accent overlays: applied via Theme.applyStyle() AFTER          -->
    <!-- setTheme(), so the accent works with ANY theme (light/dark/   -->
    <!-- gray). This replaces the old per-accent "custom" themes.      -->
    <!-- ============================================================= -->
    <style name="OverlayAccent.Green" parent="">
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#B6F09C</item>
        <item name="colorOnPrimaryContainer">#00210A</item>
    </style>

    <style name="OverlayAccent.Purple" parent="">
        <item name="colorPrimary">#6750A4</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#EADDFF</item>
        <item name="colorOnPrimaryContainer">#21005D</item>
    </style>

    <style name="OverlayAccent.Amber" parent="">
        <item name="colorPrimary">#C77800</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#FFDCAB</item>
        <item name="colorOnPrimaryContainer">#3A1E00</item>
    </style>

    <style name="OverlayAccent.Teal" parent="">
        <item name="colorPrimary">#00695C</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#6FF0DC</item>
        <item name="colorOnPrimaryContainer">#002019</item>
    </style>

    <!-- Deep blue theme: dark navy backdrop with a bright blue accent -->
    <style name="Theme.BlueLight.DeepBlue" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#5B9DFF</item>
        <item name="colorOnPrimary">#002B5C</item>
        <item name="colorPrimaryContainer">#0B3F7A</item>
        <item name="colorOnPrimaryContainer">#CFE4FF</item>
        <item name="colorSecondary">#5C7EA8</item>
        <item name="colorOnSecondary">#00223F</item>
        <item name="colorSecondaryContainer">#153A5E</item>
        <item name="colorOnSecondaryContainer">#CFE4FF</item>
        <item name="colorTertiary">#7AA2FF</item>
        <item name="colorOnTertiary">#00265C</item>
        <item name="colorTertiaryContainer">#21427A</item>
        <item name="colorOnTertiaryContainer">#D6E3FF</item>
        <item name="android:colorBackground">#0C1424</item>
        <item name="colorSurface">#101B2E</item>
        <item name="colorOnSurface">#DEE7F5</item>
        <item name="colorSurfaceVariant">#1E3050</item>
        <item name="colorOnSurfaceVariant">#BFCBDE</item>
        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>
        <item name="colorOutline">#8C9BB4</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
